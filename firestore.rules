rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read any profile (for public viewing), but only edit their own
    match /users/{userId} {
      allow read: if true;  // Photos de profil publiques
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Favorites: authenticated users can read all favorites (for queries), but only write their own
    match /favorites/{favoriteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Community stats are public read, admin write
    match /community_stats/{docId} {
      allow read: if true;
      allow write: if false; // Only admin can write (not implemented in client-side)
    }
  }
}
